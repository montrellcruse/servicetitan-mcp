# ServiceTitan credentials (fill locally; never commit credential files)
# Restrict filled files to their owner (chmod 600); keep live output out of build contexts.
ST_CLIENT_ID=
ST_CLIENT_SECRET=
ST_APP_KEY=
ST_TENANT_ID=
ST_ENVIRONMENT=integration
ST_TIMEZONE=UTC

# Discovery and mutation controls
ST_READONLY=true
ST_EXPERIMENTAL_WRITES=false
ST_CONFIRM_WRITES=false
ST_TOOL_PROFILE=full
ST_DOMAINS=
ST_TOOLS=

# Report bindings: keys are logical/default report IDs; values bind this company.
# ST_REPORT_BINDINGS={"166":{"category":"accounting","reportId":900166}}

# Bounds; final response budget includes text and structuredContent
ST_MAX_RESPONSE_CHARS=100000
ST_MAX_CONCURRENT_TOOLS=16
ST_TOOL_TIMEOUT_MS=900000
ST_MAX_SESSIONS=32
ST_LOG_LEVEL=info

# HTTP/SSE: loopback by default; set 0.0.0.0 in containers behind HTTPS
# ST_MCP_HOST=127.0.0.1
# ST_MCP_PORT=3100
# ST_MCP_API_KEY=
# ST_CORS_ORIGIN=https://your-trusted-client.example
# ST_MCP_CLIENT_ID=api-key
# ST_ALLOWED_CALLERS=api-key
# Caller restrictions use authenticated SDK identity. Arbitrary metadata/proxy headers are ignored.
